<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NEXUS LAN ARENA</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@600;800;900&family=Rajdhani:wght@600;700;800&display=swap"
    rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <style>
            :root {
                --esports-neon: #00ff87;
                --esports-cyan: #60efff;
                --esports-accent: #ff0055;
                --esports-bg: #07090e;
                --esports-card: #0d121c;
                --esports-card-border: #1b263b;
            }

            body {
                background-color: var(--esports-bg);
                background-image:
                    radial-gradient(circle at 15% 15%, rgba(0, 255, 135, 0.04) 0%, transparent 40%),
                    radial-gradient(circle at 85% 85%, rgba(96, 239, 255, 0.03) 0%, transparent 40%),
                    linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
                background-size: 100% 100%, 100% 100%, 35px 35px, 35px 35px;
                color: #d8e2ef;
                font-family: 'Inter', sans-serif;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            h1,
            h2,
            h3,
            h4,
            .brand-font {
                font-family: 'Rajdhani', sans-serif;
                letter-spacing: 1px;
                text-transform: uppercase;
                font-weight: 800;
            }

            .esports-font {
                font-family: 'Orbitron', monospace;
            }

            .esports-ticker-bar {
                background: #040608;
                border-bottom: 1px solid #141e2e;
                font-size: 0.78rem;
                letter-spacing: 0.5px;
            }

            .pulse-dot {
                width: 8px;
                height: 8px;
                background-color: #ff0055;
                border-radius: 50%;
                display: inline-block;
                box-shadow: 0 0 10px #ff0055;
                animation: pulse-live 1.2s infinite ease-in-out;
            }

            @@keyframes pulse-live {

                0%,
                100% {
                    transform: scale(1);
                    opacity: 1;
                }

                50% {
                    transform: scale(1.4);
                    opacity: 0.4;
                }
            }

            .animate-pulse {
                animation: live-pulse-glow 1.5s infinite ease-in-out;
            }

            @@keyframes live-pulse-glow {

                0%,
                100% {
                    opacity: 1;
                    box-shadow: 0 0 4px #ff0055;
                }

                50% {
                    opacity: 0.4;
                    box-shadow: 0 0 16px #ff0055;
                }
            }

            .navbar-esports {
                background: rgba(11, 16, 26, 0.90);
                backdrop-filter: blur(14px);
                border-bottom: 2px solid #1f2d45;
            }

            .navbar-brand {
                font-family: 'Orbitron', sans-serif;
                font-weight: 900;
                font-size: 1.35rem;
                color: #ffffff !important;
                letter-spacing: 1.5px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .navbar-brand span {
                background: linear-gradient(90deg, var(--esports-neon), var(--esports-cyan));
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            .nav-link-esports {
                font-family: 'Rajdhani', sans-serif;
                font-weight: 700;
                font-size: 1.05rem;
                text-transform: uppercase;
                color: #8c9bb3 !important;
                padding: 8px 18px !important;
                border-radius: 4px;
                transition: all 0.25s ease;
            }

            .nav-link-esports:hover {
                color: var(--esports-neon) !important;
                background: rgba(0, 255, 135, 0.08);
                text-shadow: 0 0 10px rgba(0, 255, 135, 0.5);
            }

            .card-custom {
                background: var(--esports-card) !important;
                border: 1px solid var(--esports-card-border) !important;
                border-radius: 8px !important;
                box-shadow: 0 12px 35px rgba(0, 0, 0, 0.5) !important;
            }

            .btn-neon-green {
                background: linear-gradient(135deg, #00ff87 0%, #00d970 100%);
                color: #06090e !important;
                font-family: 'Rajdhani', sans-serif;
                font-weight: 800;
                letter-spacing: 1px;
                text-transform: uppercase;
                border: none;
                box-shadow: 0 0 15px rgba(0, 255, 135, 0.4);
                transition: all 0.25s ease;
            }

            .btn-neon-green:hover {
                background: #00ff87;
                box-shadow: 0 0 25px rgba(0, 255, 135, 0.8);
                transform: translateY(-2px);
            }

            .text-neon {
                color: var(--esports-neon) !important;
                text-shadow: 0 0 10px rgba(0, 255, 135, 0.5);
            }

            .text-cyan {
                color: var(--esports-cyan) !important;
                text-shadow: 0 0 10px rgba(96, 239, 255, 0.5);
            }

            .table-dark-custom thead th {
                font-family: 'Rajdhani', sans-serif;
                text-transform: uppercase;
                font-weight: 800;
                color: #65758f;
                border-bottom: 1px solid #1f2d45;
            }

            .form-control,
            .form-select {
                background-color: #080d16 !important;
                border: 1px solid #1c2a3f !important;
                color: #d1dced !important;
            }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--esports-neon) !important;
                box-shadow: 0 0 12px rgba(0, 255, 135, 0.35) !important;
            }

            footer {
                margin-top: auto;
                background: #040608;
                border-top: 1px solid #141e2e;
            }
    </style>
</head>

<body>

    <div class="esports-ticker-bar py-1 px-3 d-flex justify-content-between align-items-center text-secondary">
        <div class="d-flex align-items-center gap-3">
            <span><i class="pulse-dot me-1"></i> <strong class="text-white">LAN ENGINE ONLINE</strong></span>
            <span class="d-none d-md-inline text-muted">|</span>
            <span class="d-none d-md-inline"><i class="fa-solid fa-server text-success me-1"></i> SUBNET: <span
                class="font-monospace text-light">192.168.10.0/24</span></span>
                <span class="d-none d-lg-inline text-muted">|</span>
                <span class="d-none d-lg-inline"><i class="fa-solid fa-bolt text-warning me-1"></i> TICK RATE: <span
                    class="font-monospace text-light">128 HZ</span></span>
                </div>
                <div class="d-flex align-items-center gap-3 font-monospace small">
                    <span><i class="fa-solid fa-wifi text-cyan me-1"></i> PING: <span class="text-neon">&lt;1ms</span></span>
                    <span class="badge bg-dark border border-secondary text-light">CAMPUS TOURNAMENT ED.</span>
                </div>
            </div>

            <header>
                <nav class="navbar navbar-expand-lg navbar-esports py-3">
                    <div class="container-fluid px-lg-5">
                        <a class="navbar-brand" asp-controller="Tournament" asp-action="Index">
                            <i class="fa-solid fa-shield-halved text-neon fs-3"></i>
                            <div>NEXUS <span>ARENA</span></div>
                        </a>

                        <button class="navbar-toggler border-0 text-light" type="button" data-bs-toggle="collapse"
                                data-bs-target="#esportsNav">
                            <i class="fa-solid fa-bars-staggered fs-4"></i>
                        </button>

                        <div class="collapse navbar-collapse" id="esportsNav">
                            <ul class="navbar-nav ms-auto align-items-lg-center gap-2 mt-3 mt-lg-0">
                                <li class="nav-item">
                                    <a class="nav-link nav-link-esports" asp-controller="Tournament" asp-action="Index">
                                        <i class="fa-solid fa-chart-line me-2"></i>Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-esports" asp-controller="Tournament" asp-action="RegisterStep1">
                                        <i class="fa-solid fa-user-plus me-2"></i>Team Entry
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-esports" asp-controller="Tournament" asp-action="HardwareLog">
                                        <i class="fa-solid fa-microchip me-2"></i>Hardware Log
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-esports" asp-controller="Tournament" asp-action="Brackets">
                                        <i class="fa-solid fa-trophy me-2"></i>Match Brackets
                                    </a>
                                </li>
                                <li class="nav-item ms-lg-3">
                                    <a asp-controller="Tournament" asp-action="CreateFixture"
                                       class="btn btn-neon-green btn-sm px-3 py-2">
                                        <i class="fa-solid fa-plus me-1"></i>New Match
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            </header>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="container mt-3">
                    <div class="alert alert-success bg-dark border-success text-neon alert-dismissible fade show d-flex align-items-center shadow"
                         role="alert">
                        <i class="fa-solid fa-circle-check fs-4 me-3"></i>
                        <div><strong>STATUS:</strong> @TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }

            <main class="container-fluid px-lg-5 py-4 flex-grow-1">
                @RenderBody()
            </main>

            <footer class="py-4 text-secondary small">
                <div
                    class="container-fluid px-lg-5 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-network-wired text-neon fs-5"></i>
                        <span><strong>CAMPUS LAN ESPORTS ARENA</strong> &copy; 2026. Built with ASP.NET Core &amp; EF Core
                            MySQL.</span>
                        </div>
                        <div class="d-flex align-items-center gap-3 font-monospace">
                            <span>BYOD SPEC: <strong class="text-light">ASUS TUF / LAB RIG VERIFIED</strong></span>
                            <span class="text-muted">|</span>
                            <span>STATUS: <span class="text-neon fw-bold">ONLINE</span></span>
                        </div>
                    </div>
                </footer>

                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
                @await RenderSectionAsync("Scripts", required: false)
            </body>

        </html>