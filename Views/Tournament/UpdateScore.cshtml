@model CampusLanTournamentManager.Models.MatchFixture
@{
    ViewData["Title"] = "Update Match Score";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card card-custom p-4 shadow-lg">
            <h3 class="text-neon mb-3"><i class="fa-solid fa-pen-to-square me-2"></i>Update Match Score</h3>
            <p class="text-secondary small mb-4">Entering the scores will automatically calculate and advance the winning team.</p>

            <form asp-action="UpdateScore" method="post">
                <input type="hidden" asp-for="MatchId" />
                <input type="hidden" asp-for="RoundStage" />
                <input type="hidden" asp-for="StationNumber" />
                <input type="hidden" asp-for="TeamAName" />
                <input type="hidden" asp-for="TeamBName" />

                <div class="card bg-dark border-secondary p-3 mb-4">
                    <div class="row align-items-center text-center">
                        <div class="col-5">
                            <h5 class="text-neon mb-2">@Model.TeamAName</h5>
                            <input asp-for="ScoreTeamA" type="number" min="0" max="50" class="form-control form-control-lg bg-black text-center text-light border-success fw-bold" />
                        </div>
                        <div class="col-2">
                            <span class="fs-4 text-secondary">VS</span>
                        </div>
                        <div class="col-5">
                            <h5 class="text-info mb-2">@Model.TeamBName</h5>
                            <input asp-for="ScoreTeamB" type="number" min="0" max="50" class="form-control form-control-lg bg-black text-center text-light border-info fw-bold" />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="MatchStatus" class="form-label text-light">Status</label>
                    <select asp-for="MatchStatus" class="form-select bg-dark text-light border-secondary">
                        <option value="Scheduled">Scheduled</option>
                        <option value="Live">Live</option>
                        <option value="Completed">Completed</option>
                    </select>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Brackets" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-neon-green px-4">Save & Finalize</button>
                </div>
            </form>
        </div>
    </div>
</div>