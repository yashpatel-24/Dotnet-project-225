@model List<CampusLanTournamentManager.Models.Player>
@{
    ViewData["Title"] = "Player Roster & Hardware - Step 2";
}

<div class="card card-custom p-4 shadow-lg">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-neon mb-0"><i class="fa-solid fa-users me-2"></i>Stage 2: Roster & Hardware Allocation</h3>
        <span class="badge bg-warning text-dark">Step 2 of 2</span>
    </div>
    <p class="text-secondary">Specify whether each player brings their own system (BYOD) or needs a campus lab station.
    </p>

    <form asp-action="RegisterStep2" method="post">
        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="card bg-dark border-secondary p-3 mb-3">
                <h6 class="text-success font-monospace">Player #@(i + 1) Details</h6>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label small text-secondary">In-Game Name (IGN)</label>
                        <input asp-for="@Model[i].InGameName" class="form-control bg-black text-light border-secondary"
                               required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-secondary">Full Real Name</label>
                        <input asp-for="@Model[i].FullName" class="form-control bg-black text-light border-secondary"
                               required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-secondary">Hardware Mode</label>
                        <select asp-for="@Model[i].HardwareChoice" class="form-select bg-black text-light border-secondary">
                            <option value="BYOD">BYOD (Personal Laptop/Rig)</option>
                            <option value="LabSystem">Lab Workstation Required</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-secondary">Device Info / Rig Specs</label>
                        <input asp-for="@Model[i].DeviceDetails" class="form-control bg-black text-light border-secondary"
                               placeholder="e.g. ASUS TUF A15 / Ryzen 7" />
                    </div>
                </div>
            </div>
        }

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="RegisterStep1" class="btn btn-outline-secondary">Back to Team Info</a>
            <button type="submit" class="btn btn-neon-green px-4">Complete & Confirm Registration</button>
        </div>
    </form>
</div>