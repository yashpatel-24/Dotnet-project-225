@model IEnumerable<CampusLanTournamentManager.Models.MatchFixture>
@{
    ViewData["Title"] = "LAN Arena Dashboard";
}

<!-- Hero Banner -->
<div class="p-5 mb-4 rounded-3 text-white shadow-lg position-relative overflow-hidden"
     style="background: linear-gradient(135deg, #0d1527 0%, #1a233a 100%); border: 1px solid #1f293d;">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-success font-monospace px-3 py-2 mb-3">CAMPUS LAN EVENT LIVE</span>
            <h1 class="display-5 fw-bold text-light">Campus LAN Gaming & Esports Manager</h1>
            <p class="lead text-secondary">
                Centralized system coordinating team registration pipelines, BYOD versus campus lab rig logistics, and
                real-time live match brackets.
            </p>
            <div class="d-flex gap-3 flex-wrap mt-4">
                <a asp-action="RegisterStep1" class="btn btn-neon-green btn-lg px-4">
                    <i class="fa-solid fa-user-plus me-2"></i>Register Team
                </a>
                <a asp-action="HardwareLog" class="btn btn-outline-info btn-lg px-4">
                    <i class="fa-solid fa-microchip me-2"></i>Hardware Audit
                </a>
                <a asp-action="Brackets" class="btn btn-outline-light btn-lg px-4">
                    <i class="fa-solid fa-sitemap me-2"></i>Match Brackets
                </a>
            </div>
        </div>
        <div class="col-lg-4 text-center d-none d-lg-block">
            <i class="fa-solid fa-network-wired text-neon" style="font-size: 8rem; opacity: 0.85;"></i>
        </div>
    </div>
</div>

<!-- Tournament Stats Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card card-custom p-4 border-start border-4 border-success shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-secondary small fw-bold mb-1">Registered Teams</h6>
                    <h2 class="text-white fw-bold mb-0">@(ViewBag.TotalTeams ?? 0)</h2>
                </div>
                <i class="fa-solid fa-shield-halved text-success fs-1"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-custom p-4 border-start border-4 border-primary shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-secondary small fw-bold mb-1">Total Gamers</h6>
                    <h2 class="text-white fw-bold mb-0">@(ViewBag.TotalPlayers ?? 0)</h2>
                </div>
                <i class="fa-solid fa-users text-primary fs-1"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-custom p-4 border-start border-4 border-info shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-secondary small fw-bold mb-1">BYOD Rigs (Laptops)</h6>
                    <h2 class="text-white fw-bold mb-0">@(ViewBag.ByodCount ?? 0)</h2>
                </div>
                <i class="fa-solid fa-laptop-code text-info fs-1"></i>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card card-custom p-4 border-start border-4 border-warning shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-uppercase text-secondary small fw-bold mb-1">Lab Rigs Required</h6>
                    <h2 class="text-white fw-bold mb-0">@(ViewBag.LabRequiredCount ?? 0)</h2>
                </div>
                <i class="fa-solid fa-desktop text-warning fs-1"></i>
            </div>
        </div>
    </div>
</div>

<!-- Live Fixtures Feed -->
<div class="card card-custom p-4 shadow">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="text-neon mb-1"><i class="fa-solid fa-trophy me-2"></i>Active & Upcoming Fixtures</h4>
            <p class="text-secondary small mb-0">Real-time status updates from the LAN venue floor</p>
        </div>
        <a asp-action="CreateFixture" class="btn btn-sm btn-outline-success">
            <i class="fa-solid fa-plus me-1"></i>Add Fixture
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover table-dark-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th>Stage</th>
                        <th>LAN Station / Table</th>
                        <th>Matchup</th>
                        <th>Current Score</th>
                        <th>Status</th>
                        <th>Winner</th>
                        <th class="text-end">Manage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var match in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@match.RoundStage</span></td>
                            <td class="font-monospace text-light"><i
                                class="fa-solid fa-location-dot text-danger me-1"></i>@match.StationNumber</td>
                                <td>
                                    <span class="fw-bold text-neon">@match.TeamAName</span>
                                    <span class="text-secondary mx-2">vs</span>
                                    <span class="fw-bold text-info">@match.TeamBName</span>
                                </td>
                                <td>
                                    <span class="badge bg-dark fs-6 px-3 py-1 border border-secondary font-monospace">
                                        @match.ScoreTeamA - @match.ScoreTeamB
                                    </span>
                                </td>
                                <td>
                                    @if (match.MatchStatus == "Live")
                                    {
                                        <span class="badge bg-danger animate-pulse"><i
                                            class="fa-solid fa-circle me-1 small"></i>LIVE</span>
                                        }
                                else if (match.MatchStatus == "Completed")
                                        {
                                            <span class="badge bg-success">COMPLETED</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">SCHEDULED</span>
                                        }
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(match.WinnerTeam) ? "TBD" : match.WinnerTeam)
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="UpdateScore" asp-route-id="@match.MatchId"
                                           class="btn btn-sm btn-outline-warning">
                                            Update Score
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
    else
            {
                <div class="text-center py-5">
                    <i class="fa-solid fa-gamepad text-secondary fs-1 mb-3"></i>
                    <h5 class="text-light">No match fixtures scheduled yet</h5>
                    <p class="text-secondary small">Register teams and configure matchups to populate the live board.</p>
                    <a asp-action="CreateFixture" class="btn btn-neon-green btn-sm px-3 mt-2">
                        Create First Fixture
                    </a>
                </div>
            }
        </div>