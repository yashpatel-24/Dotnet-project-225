@model IEnumerable<CampusLanTournamentManager.Models.MatchFixture>
@{
    ViewData["Title"] = "Tournament Brackets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-neon mb-1"><i class="fa-solid fa-sitemap me-2"></i>Tournament Brackets & Results</h3>
        <p class="text-secondary small mb-0">Overview of active stages, LAN stations, and advanced squads</p>
    </div>
    <a asp-action="CreateFixture" class="btn btn-neon-green">
        <i class="fa-solid fa-plus me-1"></i>New Fixture
    </a>
</div>

<div class="row g-4">
    @if (Model != null && Model.Any())
    {
        @foreach (var match in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-custom p-3 border border-secondary shadow-sm">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-secondary font-monospace">@match.RoundStage</span>
                        <span class="small text-secondary"><i
                            class="fa-solid fa-location-dot me-1 text-danger"></i>@match.StationNumber</span>
                        </div>

                        <div class="bg-dark rounded p-3 my-2 border border-secondary">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold @(match.WinnerTeam == match.TeamAName ? "text-neon" : "text-light")">
                                    @(match.WinnerTeam == match.TeamAName ? "🏆 " : "")@match.TeamAName
                                </span>
                                <span class="badge bg-black fs-6 border border-secondary px-2">@match.ScoreTeamA</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold @(match.WinnerTeam == match.TeamBName ? "text-neon" : "text-light")">
                                    @(match.WinnerTeam == match.TeamBName ? "🏆 " : "")@match.TeamBName
                                </span>
                                <span class="badge bg-black fs-6 border border-secondary px-2">@match.ScoreTeamB</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="small text-secondary">
                                Status: <strong
                                class="@(match.MatchStatus == "Live" ? "text-danger" : "text-light")">@match.MatchStatus</strong>
                            </span>
                            <a asp-action="UpdateScore" asp-route-id="@match.MatchId" class="btn btn-sm btn-outline-warning">
                                Update
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    else
        {
            <div class="col-12 text-center py-5">
                <h5 class="text-secondary">No tournament fixtures found.</h5>
                <a asp-action="CreateFixture" class="btn btn-outline-success btn-sm mt-2">Create One Now</a>
            </div>
        }
    </div>